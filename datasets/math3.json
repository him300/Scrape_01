{
  "name": "math3",
  "description": "Math3ma blog posts, including titles, publication metadata, excerpts, and article links.",
  "columns": [
    {
      "name": "title",
      "type": "string",
      "required": false
    },
    {
      "name": "url",
      "type": "url",
      "required": false
    },
    {
      "name": "publication_meta",
      "type": "string",
      "required": false
    },
    {
      "name": "excerpt",
      "type": "string",
      "required": false
    }
  ],
  "key": [
    "url"
  ],
  "sortBy": null,
  "sources": [
    {
      "id": "main",
      "url": "https://www.math3ma.com/",
      "extract": {
        "kind": "selector",
        "row": "div.collection-item-3.w-dyn-item",
        "fields": {
          "title": "h1.heading-3",
          "url": "a.link-block@href",
          "publication_meta": "div.div-for-meta",
          "excerpt": "div.w-richtext"
        }
      },
      "paginate": {
        "mode": "next",
        "selector": "a:contains(\"Next\")"
      }
    }
  ],
  "csv": {
    "delimiter": ",",
    "newline": "\r\n",
    "bom": false
  },
  "limits": {
    "maxPages": 200,
    "maxRows": 200000,
    "maxDepth": 1
  }
}
