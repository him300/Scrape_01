{
  "name": "mathm",
  "description": "Blog posts from the Math3ma website, including title, URL, publication date, category, and excerpt.",
  "columns": [
    {
      "name": "title",
      "type": "string",
      "required": false
    },
    {
      "name": "url",
      "type": "url",
      "required": false
    },
    {
      "name": "publication_date",
      "type": "date",
      "required": false
    },
    {
      "name": "category",
      "type": "string",
      "required": false
    },
    {
      "name": "excerpt",
      "type": "string",
      "required": false
    }
  ],
  "key": [
    "url"
  ],
  "sortBy": "publication_date:asc",
  "sources": [
    {
      "id": "main",
      "url": "https://www.math3ma.com/",
      "extract": {
        "kind": "selector",
        "row": "div.div-block-for-blog-items",
        "fields": {
          "title": "h1.heading-3",
          "url": "a.link-block@href",
          "publication_date": "div.meta-data-font",
          "category": "div.text-block-12",
          "excerpt": "div.w-richtext"
        }
      },
      "paginate": {
        "mode": "next",
        "selector": "a:contains(\"Next\")"
      }
    }
  ],
  "csv": {
    "delimiter": ",",
    "newline": "\r\n",
    "bom": false
  },
  "limits": {
    "maxPages": 200,
    "maxRows": 200000,
    "maxDepth": 1
  },
  "timeKinds": {
    "publication_date": "parsed"
  },
  "profile": "monster"
}
